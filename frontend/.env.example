# Optional: Google OAuth client ID. This is public client configuration, not a secret.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Leave API and Socket URLs empty when frontend and backend are served by the same Render service.
# For a separately hosted frontend, set both to the public backend origin (no trailing slash).
VITE_API_URL=
VITE_SOCKET_URL=
