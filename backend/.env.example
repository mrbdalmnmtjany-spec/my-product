PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/moaaz-social
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
# Supabase Storage (private bucket). Keep the service-role key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=moaaz-social-media
# Moaaz AI - server-side only; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
